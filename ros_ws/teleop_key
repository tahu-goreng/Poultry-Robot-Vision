#!/usr/bin/env python3

import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist

import sys
import termios
import tty
import select

class TeleopKeyboard(Node):
    def __init__(self):
        super().__init__('teleop_keyboard')
        
        # Declare parameters
        self.declare_parameter('linear_speed', 0.3)
        self.declare_parameter('angular_speed', 0.8)
        self.declare_parameter('linear_increment', 0.05)
        self.declare_parameter('angular_increment', 0.1)
        
        # Load parameters
        self.linear_speed = self.get_parameter('linear_speed').value
        self.angular_speed = self.get_parameter('angular_speed').value
        self.linear_inc = self.get_parameter('linear_increment').value
        self.angular_inc = self.get_parameter('angular_increment').value
        
        # Publisher
        self.cmd_pub = self.create_publisher(Twist, '/cmd_vel', 10)
        
        # Current velocities
        self.target_linear = 0.0
        self.target_angular = 0.0
        
        # Terminal settings
        self.settings = termios.tcgetattr(sys.stdin)
        
        # Key bindings
        self.msg = """
╔════════════════════════════════════════╗
║   ROBOT KEYBOARD TELEOP CONTROL        ║
╠════════════════════════════════════════╣
║  Movement:                             ║
║    W : Forward                         ║
║    S : Backward                        ║
║    A : Turn Left                       ║
║    D : Turn Right                      ║
║    X : Stop                            ║
║                                        ║
║  Speed Control:                        ║
║    Q : Increase Linear Speed           ║
║    Z : Decrease Linear Speed           ║
║    E : Increase Angular Speed          ║
║    C : Decrease Angular Speed          ║
║                                        ║
║  ESC or Ctrl+C : Exit                  ║
╚════════════════════════════════════════╝

Current Speeds:
  Linear:  {:.2f} m/s
  Angular: {:.2f} rad/s
"""
        
        self.get_logger().info('Teleop Keyboard Node Started')
        self.print_status()
    
    def get_key(self):
        """Get a single keypress from terminal"""
        tty.setraw(sys.stdin.fileno())
        rlist, _, _ = select.select([sys.stdin], [], [], 0.1)
        if rlist:
            key = sys.stdin.read(1)
        else:
            key = ''
        termios.tcsetattr(sys.stdin, termios.TCSADRAIN, self.settings)
        return key
    
    def print_status(self):
        """Print current speed settings"""
        print(self.msg.format(self.linear_speed, self.angular_speed))
    
    def run(self):
        """Main loop"""
        try:
            while rclpy.ok():
                key = self.get_key()
                
                if key == '\x1b':  # ESC key
                    break
                
                twist = Twist()
                
                # Movement keys
                if key == 'w' or key == 'W':
                    self.target_linear = self.linear_speed
                    self.target_angular = 0.0
                    self.get_logger().info('Moving FORWARD')
                    
                elif key == 's' or key == 'S':
                    self.target_linear = -self.linear_speed
                    self.target_angular = 0.0
                    self.get_logger().info('Moving BACKWARD')
                    
                elif key == 'a' or key == 'A':
                    self.target_linear = 0.0
                    self.target_angular = self.angular_speed
                    self.get_logger().info('Turning LEFT')
                    
                elif key == 'd' or key == 'D':
                    self.target_linear = 0.0
                    self.target_angular = -self.angular_speed
                    self.get_logger().info('Turning RIGHT')
                    
                elif key == 'x' or key == 'X':
                    self.target_linear = 0.0
                    self.target_angular = 0.0
                    self.get_logger().info('STOP')
                
                # Speed adjustment keys
                elif key == 'q' or key == 'Q':
                    self.linear_speed += self.linear_inc
                    self.get_logger().info(f'Linear speed: {self.linear_speed:.2f}')
                    
                elif key == 'z' or key == 'Z':
                    self.linear_speed = max(0.0, self.linear_speed - self.linear_inc)
                    self.get_logger().info(f'Linear speed: {self.linear_speed:.2f}')
                    
                elif key == 'e' or key == 'E':
                    self.angular_speed += self.angular_inc
                    self.get_logger().info(f'Angular speed: {self.angular_speed:.2f}')
                    
                elif key == 'c' or key == 'C':
                    self.angular_speed = max(0.0, self.angular_speed - self.angular_inc)
                    self.get_logger().info(f'Angular speed: {self.angular_speed:.2f}')
                
                elif key == '\x03':  # Ctrl+C
                    break
                
                # Publish velocity
                twist.linear.x = self.target_linear
                twist.angular.z = self.target_angular
                self.cmd_pub.publish(twist)
        
        except Exception as e:
            self.get_logger().error(f'Error: {e}')
        
        finally:
            # Stop the robot
            twist = Twist()
            self.cmd_pub.publish(twist)
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, self.settings)
    
    def destroy_node(self):
        # Send stop command
        stop = Twist()
        self.cmd_pub.publish(stop)
        termios.tcsetattr(sys.stdin, termios.TCSADRAIN, self.settings)
        super().destroy_node()


def main(args=None):
    rclpy.init(args=args)
    node = TeleopKeyboard()
    
    try:
        node.run()
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()